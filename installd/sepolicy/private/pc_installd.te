# pc-installd: lists disks, mounts partitions, copies the system, writes the ESP and EFI variables.
# The domain is permissive (the whole device is permissive for now), so it needs no allow rules yet.
type pc_installd, domain, coredomain;
type pc_installd_exec, system_file_type, exec_type, file_type;
type pc_installd_socket, file_type, coredomain_socket, mlstrustedobject;
init_daemon_domain(pc_installd)
permissive pc_installd;

# TODO enforcing. The service needs, and AOSP's neverallows forbid to a coredomain:
#   mounting labeledfs/vfat/exfat file systems and efivarfs (domain.te: mount), raw open/read/write on
#   block_device (domain.te), mknod, dac_override/dac_read_search, unlabeled sysfs (coredomain.te), and
#   relabelto on every file type when extracting the system (security.selinux of each file).
# An enforcing build needs a vendor-side helper domain, labeled block devices and sysfs nodes, or an
# exception in our own policy; e2fs_exec (mke2fs) for data.img and loop devices are allowed as is.
