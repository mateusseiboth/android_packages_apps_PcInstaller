# pc-installd: started by PcInstaller (ctl.start) in the live session; runs until stopped.
service pc_installd /system_ext/bin/pc-installd
    user root
    group root system
    # Any user's system app connects (HSUM: user 10's gid is not system); pc-installd checks the uid.
    socket pc_installd stream 0666 root system
    disabled
    oneshot
