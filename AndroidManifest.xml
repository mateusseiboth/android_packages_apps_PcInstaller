<?xml version="1.0" encoding="utf-8"?>
<!-- Runs as android.uid.system: pc-installd only answers root and the system uid. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.pcinstaller"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.REBOOT" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.PcInstaller">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
